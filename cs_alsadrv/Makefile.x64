all: cs_alsadrv

x64_asm_object_files := ../synth/x64/CyberSyn.o ../synth/x64/CLIB-asm.o ../synth/x64/WinApi-advapi32-asm.o ../synth/x64/WinApi-dsound-asm.o ../synth/x64/WinApi-kernel32-asm.o ../synth/x64/WinApi-winmm-asm.o ../synth/x64/simd-asm.o ../synth/x64/functions-asm.o
x64_asm_include_files := ../synth/x64/x64inc.inc ../synth/x64/asm_call.inc ../synth/x64/asm_pushx.inc ../synth/x64/asm_unwind.inc
x64_c_source_files := ../synth/CLIB-asm-x86.c ../synth/memory32.c ../synth/simd.c ../synth/WinApi-advapi32.c ../synth/WinApi-dsound.c ../synth/WinApi-kernel32.c ../synth/WinApi-winmm.c ../synth/x64/asm-cpu.c ../synth/x64/functions-x64.c
x64_c_include_files := ../synth/CLIB-asm-x86.h ../synth/memory32.h ../synth/platform.h ../synth/ptr32.h ../synth/simd.h ../synth/simd_sse2.h ../synth/synth.h ../synth/WinApi-advapi32.h ../synth/WinApi-dsound.h ../synth/WinApi-kernel32.h ../synth/WinApi-winmm.h ../synth/x64/x64_stack.h

CC1 != echo "${CC}" | cut -d' ' -f1
IMAGEBASE != if [ -n "`$(CC1) --help -v 2>/dev/null | grep -- -Ttext-segment`" ] ; then echo "-Ttext-segment"; else echo "--image-base"; fi

../synth/x64/CyberSyn.o: ../synth/x64/CyberSyn.asm $(x64_asm_include_files) ../synth/x64/misc.inc ../synth/x64/extern.inc ../synth/x64/seg01.inc ../synth/x64/seg02.inc ../synth/x64/seg03.inc ../synth/x64/seg07.inc
../synth/x64/CLIB-asm.o: ../synth/x64/CLIB-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/WinApi-advapi32-asm.o: ../synth/x64/WinApi-advapi32-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/WinApi-dsound-asm.o: ../synth/x64/WinApi-dsound-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/WinApi-kernel32-asm.o: ../synth/x64/WinApi-kernel32-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/WinApi-winmm-asm.o: ../synth/x64/WinApi-winmm-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/simd-asm.o: ../synth/x64/simd-asm.asm $(x64_asm_include_files) ../synth/x64/asm-calls.inc
../synth/x64/functions-asm.o: ../synth/x64/functions-asm.asm $(x64_asm_include_files)

.SUFFIXES: .asm .o
.asm.o:
	nasm $< -felf64 -Ox -i../synth/x64/ -o$@

cs_alsadrv: cs_alsadrv.c $(x64_c_source_files) $(x64_c_include_files) $(x64_asm_object_files)
	$(CC) -s -m64 -x c++ -O2 -Wall -Wl,--no-pie,$(IMAGEBASE),0x10000000 -o cs_alsadrv cs_alsadrv.c $(x64_c_source_files) -x none $(x64_asm_object_files) -I../synth -lm -lasound -lpthread

.PHONY: clean
clean:
	rm -f cs_alsadrv $(x64_asm_object_files)
